#include <stdio.h>

int queue[5], front = -1, rear = -1;

// Insert operation
void enqueue(int x)
{
    if (rear == 4)
        printf("Queue Overflow\n");
    else
    {
        if (front == -1)
            front = 0;

        queue[++rear] = x;
        printf("%d inserted\n", x);
    }
}

// Delete operation
void dequeue()
{
    if (front == -1 || front > rear)
        printf("Queue Underflow\n");
    else
        printf("%d deleted\n", queue[front++]);
}

int main()
{
    enqueue(10);
    enqueue(20);

    dequeue();

    return 0;
}
